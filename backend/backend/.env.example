# Database
DB_URL=jdbc:postgresql://localhost:5432/Team_Incident_Management
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Flyway
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1
FLYWAY_BASELINE_DESCRIPTION=Pre-Flyway Hibernate Schema

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=3600000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# ServiceNow
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password
SERVICENOW_POLL_INTERVAL_MS=300000
SERVICENOW_LOG_RETENTION=100
SERVICENOW_ASSIGNMENT_ENABLED=true
